{
  "name": "stream-bot",
  "version": "1.0.0",
  "description": "Telegram-бот для захвата мыслей и ссылок в markdown-файл задач с LLM-триагом (домен + чистая формулировка)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "gtd",
    "obsidian",
    "markdown",
    "notes",
    "anthropic",
    "claude",
    "capture"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "vonavikon",
  "homepage": "https://github.com/vonavikon/stream-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vonavikon/stream-bot.git"
  },
  "dependencies": {
    "grammy": "^1.35.0",
    "@anthropic-ai/sdk": "^0.52.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  }
}
